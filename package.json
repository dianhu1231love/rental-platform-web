{
  "name": "rental-platform-web",
  "version": "1.0.0",
  "private": true,
  "description": "租赁平台管理系统前端（Vue3 + Vite + Element Plus + Pinia）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "vue-tsc -b",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "stylelint": "stylelint \"**/*.{css,scss,vue}\" --fix",
    "stylelint:check": "stylelint \"**/*.{css,scss,vue}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{css,scss,vue}": [
      "stylelint --fix"
    ],
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.9",
    "echarts": "^5.6.0",
    "element-plus": "^2.9.1",
    "nprogress": "^0.2.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.2",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "sass": "1.83.4",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "vite": "^5.4.11",
    "vue-tsc": "^3.3.9"
  }
}
